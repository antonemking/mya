# Copy to .env and paste your keys. .env is gitignored.
# scripts/trace.mjs and scripts/pi.mjs read this file; the pi CLI itself reads
# only the environment.
ANTHROPIC_API_KEY=

# For --provider openai. Works with OpenAI-compatible endpoints too.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# For pi-jev and the +jev arms of experiments/search-eval.
TYPESAFE_API_KEY=

# Optional: override the provider and the model id.
# PI_PROVIDER=anthropic
# PI_MODEL=claude-sonnet-4-5-20250929
